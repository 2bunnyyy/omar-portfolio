---
import { profile, education, layers, hops } from '../data/profile';

// Data handed to the client-side terminal
const termData = {
  name: profile.name,
  email: profile.email,
  linkedin: profile.linkedin,
  cv: profile.cv,
  roles: profile.roles,
  languages: profile.languages,
  interests: profile.interests,
  skills: layers.map((l) => `${l.id}  ${l.title}`),
  hops: hops.map((h) => `${h.period.padEnd(12)} ${h.title}`),
};
---

<section class="contact" id="contact">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="sec-tag">05 // Ouvrir une connexion</span>
      <h2 class="sec-title">Un projet réseau, ERP ou IA ? <em>Parlons-en.</em></h2>
    </div>

    <div class="contact__grid">
      <div class="shell frame reveal">
        <div class="shell__bar mono"><span>omar@djibouti: ~ — tapez <b>help</b></span></div>
        <div class="shell__out mono" id="shell-out" aria-live="polite">
          <p>Bienvenue. Ce terminal est interactif : tapez <span class="c">help</span> pour la liste des commandes.</p>
        </div>
        <form class="shell__in mono" id="shell-form" autocomplete="off">
          <label for="shell-input" class="p">omar@djibouti:~$</label>
          <input id="shell-input" type="text" spellcheck="false" autocapitalize="off" aria-label="Commande" />
        </form>
        <div class="shell__hints mono">
          {['whoami', 'skills', 'parcours', 'safeinbox', 'contact', 'sudo hire omar'].map((c) => (
            <button type="button" data-cmd={c}>{c}</button>
          ))}
        </div>
      </div>

      <div class="side reveal">
        <a class="mail" href={`mailto:${profile.email}`}>
          <span class="mono lbl">email</span>
          <span class="val">{profile.email}</span>
          <span class="arrow">↗</span>
        </a>
        <a class="mail" href={profile.linkedin} target="_blank" rel="noopener">
          <span class="mono lbl">linkedin</span>
          <span class="val">omar-abdillahi</span>
          <span class="arrow">↗</span>
        </a>
        <a class="mail" href={profile.cv} download>
          <span class="mono lbl">cv.pdf</span>
          <span class="val">Télécharger mon CV</span>
          <span class="arrow">↓</span>
        </a>

        <div class="facts">
          <div>
            <h3 class="mono">formation</h3>
            <ul>{education.map((e) => <li><span class="mono per">{e.period}</span><span>{e.title}<small>{e.place}</small></span></li>)}</ul>
          </div>
          <div>
            <h3 class="mono">langues</h3>
            <p>{profile.languages.join(' · ')}</p>
            <h3 class="mono">hors ligne</h3>
            <p>{profile.interests.join(' · ')}</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<footer class="foot">
  <div class="wrap foot__inner mono">
    <span>© {new Date().getFullYear()} {profile.name}</span>
    <span>Conçu & déployé depuis Djibouti 🇩🇯</span>
    <a href="#top">↑ retour en haut</a>
  </div>
</footer>

<script is:inline type="application/json" id="term-data" set:html={JSON.stringify(termData)} />

<style>
  .contact__grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: clamp(24px, 4vw, 56px); align-items: start; }

  .shell { border: 1px solid var(--line-strong); background: #060a12; display: flex; flex-direction: column; height: 460px; }
  .shell__bar { padding: 12px 16px; font-size: 12px; color: var(--dim); border-bottom: 1px solid var(--line); }
  .shell__bar b { color: var(--signal); font-weight: 500; }
  .shell__out { flex: 1; overflow-y: auto; padding: 16px; font-size: 13px; line-height: 1.7; color: var(--muted); }
  .shell__out :global(p) { margin: 0; white-space: pre-wrap; word-break: break-word; }
  .shell__out :global(.c) { color: var(--signal); }
  .shell__out :global(.a) { color: var(--amber); }
  .shell__out :global(.t) { color: var(--text); }
  .shell__out :global(a) { color: var(--signal); text-decoration: underline; }
  .shell__in { display: flex; gap: 10px; align-items: center; padding: 12px 16px; border-top: 1px solid var(--line); font-size: 13px; }
  .p { color: var(--signal); white-space: nowrap; }
  .shell__in input { flex: 1; min-width: 0; background: transparent; border: 0; outline: 0; color: var(--text); font: inherit; caret-color: var(--signal); }
  .shell__hints { display: flex; flex-wrap: wrap; gap: 6px; padding: 0 16px 14px; }
  .shell__hints button { cursor: pointer; padding: 5px 9px; font: inherit; font-size: 11.5px; color: var(--muted); background: transparent; border: 1px solid var(--line-strong); transition: color 0.2s, border-color 0.2s; }
  .shell__hints button:hover { color: var(--signal); border-color: var(--signal); }

  .side { display: grid; gap: 0; }
  .mail { display: grid; grid-template-columns: 80px 1fr auto; align-items: center; gap: 14px; padding: 22px 4px; border-bottom: 1px solid var(--line-strong); transition: padding 0.35s var(--ease); }
  .mail:first-child { border-top: 1px solid var(--line-strong); }
  .mail:hover { padding-left: 14px; }
  .lbl { font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--dim); }
  .val { font: 600 clamp(15px, 1.7vw, 19px)/1.2 var(--f-display); letter-spacing: -0.02em; overflow-wrap: anywhere; }
  .arrow { color: var(--signal); font-size: 20px; transition: transform 0.3s var(--ease); }
  .mail:hover .arrow { transform: translate(3px, -3px); }

  .facts { display: grid; grid-template-columns: 1.3fr 1fr; gap: 24px; margin-top: 36px; }
  .facts h3 { margin: 0 0 10px; font-size: 11px; font-weight: 400; letter-spacing: 0.14em; text-transform: uppercase; color: var(--signal); }
  .facts h3:not(:first-child) { margin-top: 22px; }
  .facts p { margin: 0; font-size: 14.5px; color: var(--muted); }
  .facts ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .facts li { display: grid; gap: 2px; font-size: 14.5px; }
  .per { font-size: 11px; color: var(--amber); }
  .facts small { display: block; color: var(--dim); font-size: 12.5px; }

  .foot { border-top: 1px solid var(--line); }
  .foot__inner { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; padding-block: 28px; font-size: 12px; color: var(--dim); }
  .foot a:hover { color: var(--signal); }

  @media (max-width: 900px) {
    .contact__grid { grid-template-columns: 1fr; }
    .shell { height: 420px; }
  }
  @media (max-width: 480px) {
    .facts { grid-template-columns: 1fr; }
    .mail { grid-template-columns: 1fr auto; }
    .lbl { grid-column: 1 / -1; }
  }
</style>

<script>
  import { initShell } from '../scripts/shell';
  initShell();
</script>
