---
import { url } from '../data/url';
import { profile, stats } from '../data/profile';
---

<section class="hero" id="top">
  <canvas class="hero__net" id="net" aria-hidden="true"></canvas>

  <div class="wrap hero__grid">
    <div class="hero__copy">
      <p class="hero__meta mono">
        <span class="live">● EN LIGNE</span>
        <span>{profile.location}</span>
        <span class="coords">{profile.coords}</span>
      </p>

      <h1 class="hero__name">
        <span class="row"><span>Omar</span></span>
        <span class="row"><span class="outline">Abdillahi</span></span>
        <span class="row"><span>Omar<i class="cursor"></i></span></span>
      </h1>

      <p class="hero__role mono">
        <span class="prompt">&gt;</span> <span id="role" data-roles={JSON.stringify(profile.roles)}>{profile.roles[0]}</span><span class="blink">_</span>
      </p>

      <p class="hero__pitch">{profile.pitch}</p>

      <div class="hero__cta">
        <a class="btn btn--solid" href="#projects">Voir mes projets →</a>
        <a class="btn" href={profile.cv} download>Télécharger le CV</a>
      </div>
    </div>

    <aside class="hero__card frame" aria-label="Fiche profil">
      <div class="card__head mono">
        <span>NODE · OMAR-01</span><span class="ok">● UP</span>
      </div>
      <div class="card__img">
        <img src={url('/images/omar.webp')} alt="Portrait d'Omar Abdillahi Omar" width="433" height="577" loading="eager" />
        <div class="scan" aria-hidden="true"></div>
      </div>
      <dl class="card__data mono">
        <div><dt>role</dt><dd>netops · erp · ai</dd></div>
        <div><dt>org</dt><dd>TechGenius / SOPROSYS</dd></div>
        <div><dt>award</dt><dd class="amber">1er prix IA 2026</dd></div>
        <div><dt>mode</dt><dd>{profile.availability}</dd></div>
      </dl>
    </aside>
  </div>

  <div class="wrap">
    <ul class="hero__stats">
      {stats.map((s) => (
        <li><strong>{s.value}</strong><span class="mono">{s.label}</span></li>
      ))}
    </ul>
  </div>
</section>

<style>
  .hero { min-height: 100svh; padding: 120px 0 48px; display: flex; flex-direction: column; justify-content: center; overflow: hidden; }
  .hero__net { position: absolute; inset: 0; width: 100%; height: 100%; z-index: -1; mask-image: radial-gradient(ellipse 90% 80% at 60% 45%, #000 30%, transparent 85%); }
  .hero__grid { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(280px, 0.72fr); gap: clamp(32px, 6vw, 96px); align-items: center; }

  .hero__meta { display: flex; flex-wrap: wrap; gap: 8px 22px; margin: 0 0 28px; font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); }
  .live { color: var(--signal); }
  .coords { color: var(--dim); }

  .hero__name { margin: 0; font: 800 clamp(40px, 7.4vw, 112px)/0.9 var(--f-display); letter-spacing: -0.045em; text-transform: uppercase; }
  .row { display: block; overflow: hidden; padding-bottom: 0.04em; }
  .row > span { display: inline-block; transform: translateY(105%); transition: transform 1.1s var(--ease); }
  :global(html.booted) .row > span { transform: none; }
  .row:nth-child(2) > span { transition-delay: 0.08s; }
  .row:nth-child(3) > span { transition-delay: 0.16s; }
  .outline { color: transparent; -webkit-text-stroke: 1.5px var(--text); }
  .cursor { display: inline-block; width: 0.16em; height: 0.72em; margin-left: 0.08em; background: var(--signal); box-shadow: 0 0 24px var(--signal); vertical-align: -0.02em; }

  .hero__role { margin: 28px 0 0; font-size: clamp(15px, 1.6vw, 19px); color: var(--text); min-height: 1.6em; }
  .prompt { color: var(--signal); }
  .blink { color: var(--signal); animation: blink 1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }

  .hero__pitch { margin: 18px 0 0; max-width: 52ch; color: var(--muted); font-size: 17px; }
  .hero__cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 36px; }

  .hero__card { border: 1px solid var(--line-strong); background: rgba(10, 17, 29, 0.72); backdrop-filter: blur(8px); }
  .card__head { display: flex; justify-content: space-between; padding: 12px 16px; font-size: 11px; letter-spacing: 0.1em; color: var(--muted); border-bottom: 1px solid var(--line); }
  .ok { color: var(--signal); }
  .card__img { position: relative; aspect-ratio: 4 / 4.4; overflow: hidden; background: var(--ink-3); }
  .card__img img { width: 100%; height: 100%; object-fit: cover; object-position: center 30%; filter: grayscale(0.25) contrast(1.05); }
  .card__img::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 55%, rgba(5, 8, 15, 0.85)), linear-gradient(120deg, rgba(63, 242, 212, 0.12), transparent 50%); }
  .scan { position: absolute; left: 0; right: 0; height: 30%; z-index: 1; background: linear-gradient(180deg, transparent, rgba(63, 242, 212, 0.16), transparent); animation: scan 4.5s linear infinite; }
  @keyframes scan { from { top: -30%; } to { top: 100%; } }
  .card__data { margin: 0; padding: 14px 16px 16px; font-size: 12px; display: grid; gap: 6px; }
  .card__data div { display: grid; grid-template-columns: 64px 1fr; gap: 10px; }
  .card__data dt { color: var(--dim); }
  .card__data dd { margin: 0; color: var(--text); }
  .amber { color: var(--amber) !important; }

  .hero__stats { list-style: none; margin: clamp(48px, 7vw, 88px) 0 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid var(--line); }
  .hero__stats li { padding: 22px 20px 0 0; display: grid; gap: 6px; }
  .hero__stats li + li { padding-left: 20px; border-left: 1px solid var(--line); }
  .hero__stats strong { font: 600 clamp(26px, 3.2vw, 40px)/1 var(--f-display); letter-spacing: -0.03em; }
  .hero__stats span { font-size: 11.5px; color: var(--muted); letter-spacing: 0.04em; }

  @media (max-width: 960px) {
    .hero__grid { grid-template-columns: 1fr; }
    .hero__card { max-width: 420px; }
    .hero__name { font-size: min(11vw, 104px); }
  }
  @media (max-width: 640px) {
    .hero__stats { grid-template-columns: 1fr 1fr; }
    .hero__stats li + li:nth-child(3) { padding-left: 0; border-left: 0; }
    .hero__stats li { padding-bottom: 18px; }
  }
</style>

<script>
  import { startNetwork } from '../scripts/network';

  const canvas = document.getElementById('net') as HTMLCanvasElement | null;
  if (canvas) startNetwork(canvas);

  // Typewriter cycling through roles
  const el = document.getElementById('role');
  if (el && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const roles: string[] = JSON.parse(el.dataset.roles || '[]');
    let i = 0;
    const type = async () => {
      const text = roles[i];
      for (let n = text.length; n >= 0; n--) { el.textContent = text.slice(0, n); await wait(18); }
      i = (i + 1) % roles.length;
      const next = roles[i];
      for (let n = 1; n <= next.length; n++) { el.textContent = next.slice(0, n); await wait(42); }
      setTimeout(type, 2600);
    };
    const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));
    setTimeout(type, 3200);
  }
</script>
