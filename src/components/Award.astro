---
import { url } from '../data/url';
import { press } from '../data/profile';
const ticker = "FORUM NATIONAL SUR L'INTELLIGENCE ARTIFICIELLE ✦ 2–3 SEPTEMBRE 2026 ✦ DJIBOUTI ✦ 1ER PRIX ✦ TECHGENIUS ✦ SAFEINBOX ✦ ";
---

<section class="award" id="award">
  <div class="ticker mono" aria-hidden="true">
    <div class="ticker__track"><span>{ticker}</span><span>{ticker}</span></div>
  </div>

  <div class="wrap">
    <div class="sec-head reveal">
      <span class="sec-tag">01 // Alerte priorité haute</span>
      <h2 class="sec-title">Premier prix du <em>Forum National</em> sur l'IA.</h2>
    </div>

    <div class="award__grid">
      <div class="award__rank reveal">
        <div class="rank mono">
          <span class="rank__lbl">RANK</span>
          <span class="rank__num">#01</span>
          <span class="rank__sub">/ toutes catégories</span>
        </div>
        <p class="award__text">
          Avec <strong>Mohamed Hassan Isman</strong>, cofondateur de TechGenius, nous avons présenté
          <strong>SafeInbox</strong> : une solution de sécurité email propulsée par SafeAI, un moteur
          d'IA <span class="hl">conçu, entraîné et exécuté à Djibouti</span>. Le prix nous a été remis
          par le Président de la République.
        </p>

        <figure class="quote frame">
          <blockquote>« {press.quote} »</blockquote>
          <figcaption class="mono">
            <a href={press.url} target="_blank" rel="noopener">{press.outlet} — {press.date} ↗</a>
          </figcaption>
        </figure>
      </div>

      <div class="mosaic reveal">
        <figure class="m m--wide">
          <img src={url('/images/forum-laureats.webp')} alt="Les lauréats du Forum National sur l'IA aux côtés du Président de la République" loading="lazy" width="1080" height="720" />
          <figcaption class="mono">IMG_001 · Lauréats & Président de la République</figcaption>
        </figure>
        <figure class="m">
          <img src={url('/images/forum-ecran.webp')} alt="Écran géant annonçant TechGenius premier prix" loading="lazy" width="828" height="452" />
          <figcaption class="mono">IMG_002 · Annonce</figcaption>
        </figure>
        <figure class="m">
          <img src={url('/images/duo-safeinbox.webp')} alt="Omar Abdillahi Omar et Mohamed Hassan Isman au forum" loading="lazy" width="1000" height="1038" />
          <figcaption class="mono">IMG_003 · Les cofondateurs</figcaption>
        </figure>
      </div>
    </div>
  </div>
</section>

<style>
  .award { padding-top: 0; }
  .ticker { overflow: hidden; border-block: 1px solid var(--line); background: var(--amber-soft); margin-bottom: clamp(80px, 11vw, 140px); }
  .ticker__track { display: flex; width: max-content; animation: tick 38s linear infinite; }
  .ticker span { padding: 16px 0; font-size: 13px; letter-spacing: 0.18em; color: var(--amber); white-space: pre; }
  @keyframes tick { to { transform: translateX(-50%); } }

  .award__grid { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: clamp(32px, 5vw, 72px); align-items: start; }

  .rank { display: grid; grid-template-columns: auto 1fr; align-items: end; gap: 0 16px; padding-bottom: 28px; margin-bottom: 28px; border-bottom: 1px solid var(--line); }
  .rank__lbl { grid-column: 1 / -1; font-size: 11px; letter-spacing: 0.2em; color: var(--dim); }
  .rank__num { font: 800 clamp(80px, 12vw, 150px)/0.85 var(--f-display); letter-spacing: -0.06em; color: var(--amber); text-shadow: 0 0 60px var(--amber-glow); }
  .rank__sub { font-size: 12px; color: var(--muted); padding-bottom: 10px; }

  .award__text { margin: 0 0 32px; font-size: 17px; color: var(--muted); }
  .award__text strong { color: var(--text); font-weight: 500; }
  .hl { color: var(--signal); }

  .quote { margin: 0; padding: 24px 26px; border: 1px solid var(--line); background: var(--ink-2); }
  .quote blockquote { margin: 0 0 14px; font: 400 17px/1.55 var(--f-sans); font-style: italic; color: var(--text); }
  .quote figcaption { font-size: 12px; }
  .quote a { color: var(--signal); }
  .quote a:hover { text-decoration: underline; }

  .mosaic { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .m { margin: 0; position: relative; overflow: hidden; border: 1px solid var(--line); background: var(--ink-3); }
  .m--wide { grid-column: 1 / -1; aspect-ratio: 3 / 2; }
  .m:not(.m--wide) { aspect-ratio: 1 / 1; }
  .m img { width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s var(--ease), filter 0.6s; filter: saturate(0.85); }
  .m:hover img { transform: scale(1.04); filter: saturate(1.05); }
  .m figcaption { position: absolute; left: 0; right: 0; bottom: 0; padding: 26px 12px 10px; font-size: 10.5px; letter-spacing: 0.06em; color: #e3ebf5; background: linear-gradient(transparent, rgba(5, 8, 15, 0.9)); }

  @media (max-width: 900px) {
    .award__grid { grid-template-columns: 1fr; }
  }
</style>
